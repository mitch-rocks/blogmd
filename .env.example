# Copy to .env and adjust. All values are optional.

# Database: default is a local SQLite file in content/. For MongoDB (as in docker-compose.yml):
# DATABASE_URL=mongodb://localhost:27017/blogmd
# MEDIA_URL=gridfs://                # store uploads in MongoDB; default is content/media on disk

SITE_NAME=Mitch Naake
MAX_UPLOAD_MB=50
ALLOW_REGISTRATION=false
SESSION_COOKIE_SECURE=false          # true when served over HTTPS
# TRUST_PROXY=1                      # behind one reverse proxy (Traefik)
# REAL_IP_HEADER=CF-Connecting-IP    # behind Cloudflare
# SECRET_KEY=change-me               # otherwise generated once and stored in the database
DEBUG=false
